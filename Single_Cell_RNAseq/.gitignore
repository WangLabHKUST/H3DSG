# Nothing in staging is published: scripts awaiting rewrite, and read files for samples
# that are not part of this study.

# Tier 0 and tier 1 live in GEO and Zenodo, never in the repository.
*.rds
*.Rda
*.h5
*.h5ad
*.mtx
*.mtx.gz
barcodes.tsv*
features.tsv*
genes.tsv*

# Local copies of the raw counts and of the Seurat objects the pipeline reads, kept here so
# the pipeline can run from this directory. They are never committed; only the manifest
# that lists them (path, size, md5, source) is. inputs/README.md describes both.
objects/*
!objects/MANIFEST.tsv
inputs/raw_counts/

# Sample metadata copied in for the analysis code: the main mapping carries clinical
# fields. Not committed; the published sample table is ../sample_metadata.tsv.
inputs/meta/
inputs/sample_metadata.tsv

# Read files of samples that are not part of this study.
inputs/mut_reads/batch_reads/DHY-1.*
inputs/mut_reads/batch_reads/DHY-2.*
inputs/mut_reads/batch_reads/DHY-4.*
inputs/mut_reads/batch_reads/MTSC08.*
inputs/mut_reads/batch_reads/WX-*

# Figure output is regenerated by the scripts in figures/.
figures/*.pdf
figures/*.png
figures/*.jpg

# Everything a pipeline re-run writes goes to results/ and stays out.
results/
logs/
Rplots.pdf
.Rhistory
.RData
.Rproj.user/
__pycache__/
*.pyc
.DS_Store
